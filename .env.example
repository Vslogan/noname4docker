# 无名杀 Docker 部署配置示例
#
# 使用方法：
#   cp .env.example .env
#   # 按需修改下面的值，然后执行 noname start
#
# 该文件由 docker compose 自动读取；配合 noname 命令使用时同样生效。

# ---------------------------------------------------------------------------
# 端口
# ---------------------------------------------------------------------------
# 网页服务端口（浏览器访问 http://<主机>:<端口>/）
NONAME_WEB_PORT=8089
# 联机服务端口（游戏内「联机」模式填写 <主机>:<端口>）
NONAME_ONLINE_PORT=8082
# 端口在宿主机上的监听地址：0.0.0.0 = 所有网卡，127.0.0.1 = 仅本机（配合反向代理）
NONAME_BIND_ADDRESS=0.0.0.0

# ---------------------------------------------------------------------------
# 镜像与数据
# ---------------------------------------------------------------------------
# 镜像名称（标签由 noname update 自动维护，一般无需修改）
NONAME_IMAGE=noname
# 强制指定镜像标签，例如 v1.11.7；留空则由 noname 命令管理
# NONAME_TAG=latest
# 保存已导入扩展的数据卷名称
NONAME_EXTENSION_VOLUME=noname-extensions
# Compose 项目名（影响容器名前缀）
# COMPOSE_PROJECT_NAME=noname

# ---------------------------------------------------------------------------
# 构建参数
# ---------------------------------------------------------------------------
# Node.js / pnpm 版本，默认与上游 CI 保持一致
# NONAME_NODE_VERSION=24
# NONAME_PNPM_VERSION=10
# 追加给 docker build 的参数，例如 --no-cache 或 --pull
# NONAME_BUILD_EXTRA_ARGS=--no-cache

# ---------------------------------------------------------------------------
# 调试
# ---------------------------------------------------------------------------
# 设为 1 时网页服务会输出访问日志
# NONAME_DEBUG=0

# ---------------------------------------------------------------------------
# noname 命令相关
# ---------------------------------------------------------------------------
# 上游仓库地址（国内网络可替换为镜像地址）
# NONAME_UPSTREAM=https://github.com/libnoname/noname.git
# GitHub Token，可避免 release 检查触发 API 限流
# GITHUB_TOKEN=
# 更新后保留的历史版本镜像数量（默认 2，便于回滚）
# NONAME_KEEP_IMAGES=2
